# Copia este archivo a .env y rellena tus claves. NUNCA subas .env al repo.
# (Cuentas gratuitas bastan para el lab.)

# VirusTotal — https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# TheHive (cuando lo despliegues en la VLAN SOC)
THEHIVE_URL=http://127.0.0.1:9000
THEHIVE_API_KEY=

# SOAR handler (loopback por defecto — no exponer)
SOAR_HOST=127.0.0.1
SOAR_PORT=5000

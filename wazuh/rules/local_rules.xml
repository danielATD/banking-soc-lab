<group name="local,syslog,pfsense,">

  <rule id="100100" level="5">
    <decoded_as>pfsense-fw</decoded_as>
    <description>pfSense: bloqueo de firewall de $(srcip) hacia $(dstip):$(dstport)</description>
    <group>firewall_block,pci_dss_1.4,</group>
  </rule>

  <rule id="100101" level="10" frequency="15" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>pfSense: posible escaneo de puertos desde $(srcip)</description>
    <group>firewall_scan,pci_dss_11.4,</group>
  </rule>

</group>
